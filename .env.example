# توکن ربات تلگرام (از BotFather)
TELEGRAM_BOT_TOKEN=

# شناسه‌های عددی تلگرام مجاز (با کاما جدا شوند)
ALLOWED_USER_IDS=

# مسیر state ربات
STATE_FILE=/root/freebuff-guardian/state.json

# مسیر credentials فری‌باف (پیش‌فرض ~/.config/manicode/credentials.json)
# FREEBUFF_CREDENTIALS_PATH=/root/.config/manicode/credentials.json

# پوشهٔ اکانت‌های اضافه (چند-اکانتی). پیش‌فرض: ./accounts
# FREEBUFF_ACCOUNTS_DIR=/root/freebuff-guardian/accounts

# پروکسی پیش‌فرض اکانت default (برای رفع محدودیت ip_capped). هر اکانت هم
# می‌تواند پروکسی جدا داشته باشد (از دکمهٔ «🌐 پروکسی اکانت» یا /proxy).
# FREEBUFF_PROXY=http://user:pass@host:port

# پوشهٔ فایل‌های بکاپ اکانت‌ها. پیش‌فرض: ./backups
# FREEBUFF_BACKUP_DIR=/root/freebuff-guardian/backups

# مدل و ایجنت پیش‌فرض چت (رایگان)
# توجه: در مود رایگان هر مدل فقط با یک ایجنت مشخص مجاز است. ربات ایجنت را
# خودکار از روی مدل تعیین می‌کند؛ این مقدار فقط به‌عنوان fallback است.
FREEBUFF_MODEL=z-ai/glm-5.3-flash
FREEBUFF_AGENT=base2-free-glm-5-3-flash

# سطح لاگ: debug | info | warn | error
LOG_LEVEL=info

# سقف طول پاسخ تلگرام و تعداد پیام تاریخچه
MAX_ANSWER_CHARS=3500
MAX_HISTORY_MESSAGES=40

# چند دقیقه قبل از انقضای جلسه (۱ ساعته) هشدار داده شود (0 = خاموش)
SESSION_WARN_MIN=5

# کنترل سرور توسط مدل: ابزار run_terminal_command (دستورهای خطرناک تأیید می‌گیرند)
ENABLE_SERVER_TOOLS=true
# پوشهٔ کاری اجرای دستورها (خالی = پوشهٔ ربات)
FREEBUFF_WORKDIR=

# مهلت اجرای هر دستور (ثانیه)
CMD_TIMEOUT_SEC=60

# سقف تعداد گام‌های ابزار در هر درخواست چت (پیش‌فرض ۴۰)
FREEBUFF_MAX_STEPS=40
# اگر مدل یک ابزار را با همان آرگومان‌ها بیش از این تعداد تکرار کند، متوقف می‌شود
# و پاسخ نهایی گرفته می‌شود (پیش‌فرض ۲).
FREEBUFF_MAX_TOOL_REPEAT=2

# مهلت هر درخواست HTTP به فری‌باف (ثانیه) تا هیچ درخواستی بی‌نهایت معلق نماند
FREEBUFF_HTTP_TIMEOUT_SEC=180
# مهلت کل یک اجرای چت (ثانیه)؛ بعد از آن متوقف و علت گزارش می‌شود
FREEBUFF_RUN_TIMEOUT_SEC=300
